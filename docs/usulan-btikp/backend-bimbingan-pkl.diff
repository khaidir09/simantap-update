+<?php
+/**
+ * Jurnal Bimbingan PKL: guru membimbing siswa kelas XII yang sedang Praktik Kerja Lapangan.
+ * Spesifikasi: docs/specs/jurnal-bimbingan-pkl.md
+ *
+ * - pkl_dudi       : master tempat PKL (DU/DI).
+ * - pkl_penempatan : siswa ↔ DU/DI ↔ guru pembimbing ↔ periode. Periode satu siswa tidak boleh
+ *                    tumpang tindih, sehingga satu siswa hanya punya satu pembimbing per tanggal.
+ * - pkl_jurnal     : satu kegiatan bimbingan untuk satu penempatan pada satu tanggal.
+ * - Tidak menyentuh presensi harian, insiden, poin, panggilan orang tua, atau journal_entries.
+ * - Pembimbing hanya GURU dengan penugasan mapel kelas XII (teacher_subjects).
+ *
+ * Hanya boleh dimuat lewat api/index.php.
+ */
+if (!defined('SIMANTAP_API')) exit;
+
+const PKL_MSG_DENY       = 'Anda tidak memiliki akses ke Bimbingan PKL.';
+const PKL_MSG_SYARAT     = 'Hanya guru dengan penugasan mapel kelas XII yang dapat menjadi pembimbing PKL. Lengkapi penugasan mapel di Profil bila Anda mengajar kelas XII.';
+const PKL_JENIS          = ['KUNJUNGAN' => 'Kunjungan/Monitoring DU/DI', 'DARING' => 'Bimbingan Daring', 'SEKOLAH' => 'Bimbingan di Sekolah'];
+const PKL_JENIS_PENDEK   = ['KUNJUNGAN' => 'Kunjungan', 'DARING' => 'Daring', 'SEKOLAH' => 'Di Sekolah'];
+const PKL_MAKS_HARI      = 366;
+const PKL_MAKS_FOTO      = 3;
+const PKL_MAKS_UNGGAH    = 2 * 1024 * 1024;
+const PKL_MIME_FOTO      = ['image/jpeg' => 'jpg', 'image/png' => 'png', 'image/webp' => 'webp'];
+const PKL_POLA_FOTO      = '#^uploads/journals/pkl/\d{6}/[a-f0-9]{32}\.(jpg|png|webp)$#';
+const PKL_SISWA_AKTIF    = "(s.status IS NULL OR s.status = '' OR UPPER(s.status) = 'AKTIF')";
+
+// ---------------------------------------------------------------------------
+// Tabel
+// ---------------------------------------------------------------------------
+
+/**
+ * Buat tabel bila belum ada (sekali per request). DDL memicu implicit commit,
+ * jadi jangan dipanggil di dalam transaksi.
+ */
+function pklPastikanTabel(mysqli $db): void
+{
+    static $sudah = false;
+    if ($sudah) return;
+    $db->query("CREATE TABLE IF NOT EXISTS `pkl_dudi` (
+        `id` varchar(64) NOT NULL,
+        `nama` varchar(255) NOT NULL,
+        `nama_norm` varchar(255) NOT NULL,
+        `bidang_usaha` varchar(150) DEFAULT NULL,
+        `alamat` text DEFAULT NULL,
+        `pembimbing_nama` varchar(150) DEFAULT NULL COMMENT 'pembimbing industri',
+        `pembimbing_telp` varchar(30) DEFAULT NULL,
+        `catatan` text DEFAULT NULL,
+        `dibuat_oleh` varchar(128) NOT NULL,
+        `dibuat_pada` datetime NOT NULL,
+        `diubah_pada` datetime DEFAULT NULL,
+        PRIMARY KEY (`id`),
+        UNIQUE KEY `uq_pkl_dudi_norm` (`nama_norm`)
+    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci");
+    $db->query("CREATE TABLE IF NOT EXISTS `pkl_penempatan` (
+        `id` varchar(64) NOT NULL,
+        `siswa_id` varchar(128) NOT NULL,
+        `siswa_nama` varchar(255) NOT NULL,
+        `kelas_id` varchar(50) NOT NULL,
+        `kelas_nama` varchar(100) NOT NULL,
+        `dudi_id` varchar(64) NOT NULL,
+        `guru_id` varchar(128) NOT NULL,
+        `guru_nama` varchar(255) NOT NULL,
+        `tanggal_mulai` date NOT NULL,
+        `tanggal_selesai` date NOT NULL,
+        `tahun_ajaran` varchar(20) NOT NULL,
+        `dibuat_oleh` varchar(128) NOT NULL,
+        `dibuat_pada` datetime NOT NULL,
+        `diubah_oleh` varchar(128) DEFAULT NULL,
+        `diubah_pada` datetime DEFAULT NULL,
+        PRIMARY KEY (`id`),
+        KEY `idx_pklp_siswa` (`siswa_id`, `tanggal_mulai`),
+        KEY `idx_pklp_guru` (`guru_id`, `tanggal_mulai`),
+        KEY `idx_pklp_kelas` (`kelas_id`),
+        KEY `idx_pklp_dudi` (`dudi_id`)
+    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci");
+    $db->query("CREATE TABLE IF NOT EXISTS `pkl_jurnal` (
+        `id` varchar(64) NOT NULL,
+        `penempatan_id` varchar(64) NOT NULL,
+        `guru_id` varchar(128) NOT NULL,
+        `guru_nama` varchar(255) NOT NULL,
+        `siswa_id` varchar(128) NOT NULL,
+        `tanggal` date NOT NULL,
+        `jam_mulai` char(5) NOT NULL,
+        `jam_selesai` char(5) NOT NULL,
+        `jenis` varchar(20) NOT NULL COMMENT 'KUNJUNGAN | DARING | SEKOLAH',
+        `uraian` text NOT NULL,
+        `kondisi_siswa` text DEFAULT NULL,
+        `permasalahan` text DEFAULT NULL,
+        `tindak_lanjut` text DEFAULT NULL,
+        `foto_json` text DEFAULT NULL,
+        `dibuat_pada` datetime NOT NULL,
+        `diubah_pada` datetime DEFAULT NULL,
+        PRIMARY KEY (`id`),
+        KEY `idx_pklj_guru_tgl` (`guru_id`, `tanggal`),
+        KEY `idx_pklj_penempatan` (`penempatan_id`, `tanggal`),
+        KEY `idx_pklj_siswa` (`siswa_id`, `tanggal`)
+    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci");
+    $sudah = true;
+}
+
+// ---------------------------------------------------------------------------
+// Helper umum
+// ---------------------------------------------------------------------------
+
+function pklWajibMetode(string $metode): void
+{
+    if (($_SERVER['REQUEST_METHOD'] ?? 'GET') !== $metode) {
+        header('Allow: ' . $metode);
+        errorResponse('Metode tidak diizinkan', 405);
+    }
+}
+
+function pklHariIni(): string
+{
+    return date('Y-m-d');
+}
+
+function pklSekarang(): string
+{
+    return date('Y-m-d H:i:s');
+}
+
+function pklTanggalValid($tgl): bool
+{
+    if (!is_string($tgl) || !preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $tgl, $m)) return false;
+    return checkdate((int)$m[2], (int)$m[3], (int)$m[1]);
+}
+
+function pklTglPendek(?string $ymd): string
+{
+    $p = explode('-', substr((string)$ymd, 0, 10));
+    return count($p) === 3 ? "$p[2]/$p[1]/$p[0]" : '-';
+}
+
+function pklTambahHari(string $ymd, int $hari): string
+{
+    return (new DateTimeImmutable($ymd))->modify(($hari >= 0 ? '+' : '') . $hari . ' day')->format('Y-m-d');
+}
+
+function pklTeks(array $body, string $kunci, int $maks, string $label, bool $wajib = false): ?string
+{
+    $v = $body[$kunci] ?? '';
+    $v = is_scalar($v) ? trim((string)$v) : '';
+    if ($v === '') {
+        if ($wajib) errorResponse("$label wajib diisi");
+        return null;
+    }
+    if (mb_strlen($v, 'UTF-8') > $maks) errorResponse("$label maksimal $maks karakter");
+    return $v;
+}
+
+function pklAmbilSatu(mysqli $db, string $sql, string $types, array $params): ?array
+{
+    $stmt = $db->prepare($sql);
+    if ($types !== '') $stmt->bind_param($types, ...$params);
+    $stmt->execute();
+    return $stmt->get_result()->fetch_assoc() ?: null;
+}
+
+function pklAmbilSemua(mysqli $db, string $sql, string $types, array $params): array
+{
+    $stmt = $db->prepare($sql);
+    if ($types !== '') $stmt->bind_param($types, ...$params);
+    $stmt->execute();
+    return $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
+}
+
+/**
+ * Nama DU/DI ternormalisasi untuk dedup: huruf kecil, tanda baca jadi spasi, spasi tunggal,
+ * tanpa awalan badan usaha (PT/CV/UD/PD/FA/Firma) dan akhiran Tbk/Persero.
+ */
+function pklNormNama(string $nama): string
+{
+    $n = mb_strtolower($nama, 'UTF-8');
+    $n = preg_replace('/[^\p{L}\p{N}]+/u', ' ', $n) ?? '';
+    $n = trim(preg_replace('/\s+/', ' ', $n) ?? '');
+    $tanpa = preg_replace('/^(pt|cv|ud|pd|fa|firma)\s+/', '', $n) ?? $n;
+    $tanpa = trim(preg_replace('/\s+(tbk|persero)$/', '', $tanpa) ?? $tanpa);
+    return mb_substr($tanpa !== '' ? $tanpa : $n, 0, 255, 'UTF-8');
+}
+
+// ---------------------------------------------------------------------------
+// Tingkat kelas XII
+// ---------------------------------------------------------------------------
+
+/**
+ * Token pertama ("XII" dari "XII TKJ 1" / "XII_TKJ_1") bernilai XII atau 12.
+ */
+function pklTokenXII(?string $teks): bool
+{
+    $t = preg_split('/[\s_.\-]+/', strtoupper(trim((string)$teks)), -1, PREG_SPLIT_NO_EMPTY);
+    return $t && in_array($t[0], ['XII', '12'], true);
+}
+
+/**
+ * Peta kelas: kunci ternormalisasi (id dan nama) => ['id', 'name', 'xii'].
+ * Tingkat dari classes.level; bila kosong, dari token pertama id/nama kelas.
+ */
+function pklPetaKelas(mysqli $db): array
+{
+    static $peta = null;
+    if ($peta !== null) return $peta;
+    $peta = [];
+    try {
+        $res = $db->query("SELECT id, name, level FROM classes");
+        while ($res && ($c = $res->fetch_assoc())) {
+            $level = trim((string)$c['level']);
+            $xii = $level !== '' ? pklTokenXII($level) : (pklTokenXII($c['id']) || pklTokenXII($c['name']));
+            $info = ['id' => (string)$c['id'], 'name' => (string)($c['name'] ?: $c['id']), 'xii' => $xii];
+            foreach ([$c['id'], $c['name']] as $k) {
+                $k = normalizeClassKey($k);
+                if ($k !== '' && !isset($peta[$k])) $peta[$k] = $info;
+            }
+        }
+    } catch (Throwable $e) {
+        // Tabel classes belum ada: semua penentuan memakai token nama kelas
+    }
+    return $peta;
+}
+
+function pklKelasXII(array $peta, ?string $kelasId, ?string $kelasNama = null): bool
+{
+    foreach ([$kelasId, $kelasNama] as $ref) {
+        $k = normalizeClassKey($ref);
+        if ($k !== '' && isset($peta[$k])) return $peta[$k]['xii'];
+    }
+    return pklTokenXII($kelasId) || pklTokenXII($kelasNama);
+}
+
+/**
+ * Syarat pembimbing (§4.1): ada baris teacher_subjects yang menyasar kelas XII.
+ * class_ids (JSON) diutamakan; bila kosong, dipakai class_level.
+ */
+function pklSyaratPembimbing(mysqli $db, string $uid, ?array $baris = null): bool
+{
+    if ($baris === null) {
+        $baris = pklAmbilSemua($db, "SELECT class_level, class_ids FROM teacher_subjects WHERE teacher_id = ?", 's', [$uid]);
+    }
+    $peta = pklPetaKelas($db);
+    foreach ($baris as $r) {
+        $ids = json_decode((string)($r['class_ids'] ?? ''), true);
+        if (is_array($ids) && count($ids) > 0) {
+            foreach ($ids as $cid) {
+                if (is_scalar($cid) && pklKelasXII($peta, (string)$cid)) return true;
+            }
+            continue;
+        }
+        if (pklTokenXII($r['class_level'] ?? '')) return true;
+    }
+    return false;
+}
+
+// ---------------------------------------------------------------------------
+// Konteks & otorisasi
+// ---------------------------------------------------------------------------
+
+/**
+ * Konteks pengguna dari baris users terbaru. null bila role tidak berhak sama sekali.
+ */
+function pklKonteksDari(mysqli $db, array $fresh): ?array
+{
+    $role = (string)$fresh['role'];
+    if (!in_array($role, ['GURU', 'KEPALA_SEKOLAH', 'ADMIN'], true)) return null;
+    $ctx = [
+        'uid'        => (string)$fresh['uid'],
+        'nama'       => (string)$fresh['displayName'],
+        'role'       => $role,
+        'admin'      => $role === 'ADMIN',
+        'kepsek'     => $role === 'KEPALA_SEKOLAH',
+        'guru'       => $role === 'GURU',
+        'pembimbing' => false,
+        'wali'       => null,
+    ];
+    if ($role !== 'GURU') return $ctx;
+
+    $ctx['pembimbing'] = pklSyaratPembimbing($db, $ctx['uid']);
+    $homeroom = trim((string)($fresh['class_homeroom'] ?? ''));
+    if ($homeroom !== '') {
+        $scope = homeroomClassScope($db, $homeroom);
+        $ref = resolveClassRef($db, $scope['classId']);
+        if (pklKelasXII(pklPetaKelas($db), $ref['id'], $ref['name'])) {
+            $ctx['wali'] = ['classId' => $ref['id'], 'className' => $ref['name'], 'classKeys' => $scope['classKeys']];
+        }
+    }
+    return $ctx;
+}
+
+function pklKonteks(mysqli $db): array
+{
+    $ctx = pklKonteksDari($db, loadFreshUser($db, requireAuth()));
+    if ($ctx === null) errorResponse(PKL_MSG_DENY, 403);
+    pklPastikanTabel($db);
+    return $ctx;
+}
+
+/** Boleh melihat master DU/DI dan kandidat siswa. */
+function pklBolehBaca(array $ctx): bool
+{
+    return $ctx['admin'] || $ctx['kepsek'] || $ctx['pembimbing'] || $ctx['wali'] !== null;
+}
+
+/**
+ * Kondisi SQL cakupan baca penempatan untuk GURU: miliknya + kelas perwalian XII.
+ * $alias = alias tabel pkl_penempatan. Admin/Kepsek: tanpa batas ('1=1').
+ */
+function pklKondisiCakupan(array $ctx, string $alias, string &$types, array &$params): string
+{
+    if ($ctx['admin'] || $ctx['kepsek']) return '1=1';
+    $bagian = ["$alias.guru_id = ?"];
+    $types .= 's';
+    $params[] = $ctx['uid'];
+    if ($ctx['wali'] !== null) {
+        $bagian[] = rekapKeyCondition(["$alias.kelas_id", "$alias.kelas_nama"], $ctx['wali']['classKeys'], $types, $params);
+    }
+    return '(' . implode(' OR ', $bagian) . ')';
+}
+
+function pklMilikPenempatan(array $ctx, array $p): bool
+{
+    return $ctx['admin'] || ($ctx['guru'] && $p['guru_id'] === $ctx['uid']);
+}
+
+function pklDalamCakupanWali(array $ctx, ?string $kelasId, ?string $kelasNama): bool
+{
+    if ($ctx['wali'] === null) return false;
+    return in_array(normalizeClassKey($kelasId), $ctx['wali']['classKeys'], true)
+        || in_array(normalizeClassKey($kelasNama), $ctx['wali']['classKeys'], true);
+}
+
+/**
+ * Kunci bernama per siswa agar cek tumpang tindih + insert tidak balapan antar-guru.
+ */
+function pklKunciSiswa(mysqli $db, string $siswaId): void
+{
+    $nama = 'pkl_siswa_' . md5($siswaId);
+    $r = pklAmbilSatu($db, "SELECT GET_LOCK(?, 10) AS ok", 's', [$nama]);
+    if ((int)($r['ok'] ?? 0) !== 1) throw new RuntimeException('Gagal mengunci data siswa, coba lagi.');
+}
+
+function pklLepasKunciSiswa(mysqli $db, string $siswaId): void
+{
+    $nama = 'pkl_siswa_' . md5($siswaId);
+    pklAmbilSatu($db, "SELECT RELEASE_LOCK(?) AS ok", 's', [$nama]);
+}
+
+/**
+ * Penempatan lain milik siswa yang rentangnya beririsan dengan [mulai, selesai].
+ */
+function pklCekTumpangTindih(mysqli $db, string $siswaId, string $mulai, string $selesai, string $kecualiId = ''): ?array
+{
+    return pklAmbilSatu($db,
+        "SELECT id, guru_nama, tanggal_mulai, tanggal_selesai FROM pkl_penempatan
+         WHERE siswa_id = ? AND tanggal_mulai <= ? AND tanggal_selesai >= ? AND id <> ?
+         ORDER BY tanggal_mulai LIMIT 1",
+        'ssss', [$siswaId, $selesai, $mulai, $kecualiId]);
+}
+
+function pklPesanBentrok(array $b): string
+{
+    return 'Siswa sudah dibimbing oleh ' . $b['guru_nama'] . ' (periode '
+        . pklTglPendek($b['tanggal_mulai']) . ' – ' . pklTglPendek($b['tanggal_selesai']) . ')';
+}
+
+function pklStatusPenempatan(string $mulai, string $selesai): string
+{
+    $hari = pklHariIni();
+    if ($mulai > $hari) return 'AKAN_DATANG';
+    if ($selesai < $hari) return 'SELESAI';
+    return 'AKTIF';
+}
+
+function pklValidasiRentang(string $mulai, string $selesai): void
+{
+    if (!pklTanggalValid($mulai) || !pklTanggalValid($selesai)) errorResponse('Tanggal mulai dan selesai wajib diisi dengan benar');
+    if ($selesai < $mulai) errorResponse('Tanggal selesai tidak boleh sebelum tanggal mulai');
+    $hari = (new DateTimeImmutable($mulai))->diff(new DateTimeImmutable($selesai))->days + 1;
+    if ($hari > PKL_MAKS_HARI) errorResponse('Periode penempatan maksimal ' . PKL_MAKS_HARI . ' hari');
+}
+
+function pklRentangJurnal(mysqli $db, string $penempatanId): array
+{
+    $r = pklAmbilSatu($db, "SELECT COUNT(*) AS n, MIN(tanggal) AS awal, MAX(tanggal) AS akhir FROM pkl_jurnal WHERE penempatan_id = ?", 's', [$penempatanId]);
+    return ['n' => (int)($r['n'] ?? 0), 'awal' => $r['awal'] ?? null, 'akhir' => $r['akhir'] ?? null];
+}
+
+// ---------------------------------------------------------------------------
+// Format keluaran
+// ---------------------------------------------------------------------------
+
+const PKL_SQL_PENEMPATAN = "SELECT p.*, d.nama AS dudi_nama, d.alamat AS dudi_alamat, d.bidang_usaha AS dudi_bidang,
+        d.pembimbing_nama AS dudi_pembimbing, d.pembimbing_telp AS dudi_telp,
+        s.id AS s_id, s.nisn AS s_nisn, s.status AS s_status,
+        (SELECT COUNT(*) FROM pkl_jurnal j WHERE j.penempatan_id = p.id) AS jumlah_jurnal,
+        (SELECT MAX(j.tanggal) FROM pkl_jurnal j WHERE j.penempatan_id = p.id) AS jurnal_terakhir
+    FROM pkl_penempatan p
+    LEFT JOIN pkl_dudi d ON d.id = p.dudi_id
+    LEFT JOIN students s ON s.id = p.siswa_id";
+
+function pklBarisPenempatan(array $r, ?array $ctx = null): array
+{
+    $statusSiswa = $r['s_id'] === null ? 'TERHAPUS' : strtoupper(trim((string)$r['s_status']));
+    return [
+        'id'                => $r['id'],
+        'siswa_id'          => $r['siswa_id'],
+        'siswa_nama'        => $r['siswa_nama'],
+        'studentName'       => $r['siswa_nama'],
+        'nisn'              => $r['s_nisn'] ?? null,
+        'kelas_id'          => $r['kelas_id'],
+        'kelas_nama'        => $r['kelas_nama'],
+        'className'         => $r['kelas_nama'],
+        'siswa_status'      => in_array($statusSiswa, ['', 'AKTIF'], true) ? null : $statusSiswa,
+        'dudi_id'           => $r['dudi_id'],
+        'dudi_nama'         => $r['dudi_nama'] ?? '(DU/DI terhapus)',
+        'dudi_alamat'       => $r['dudi_alamat'] ?? null,
+        'dudi_bidang'       => $r['dudi_bidang'] ?? null,
+        'dudi_pembimbing'   => $r['dudi_pembimbing'] ?? null,
+        'dudi_telp'         => $r['dudi_telp'] ?? null,
+        'guru_id'           => $r['guru_id'],
+        'guru_nama'         => $r['guru_nama'],
+        'teacherName'       => $r['guru_nama'],
+        'tanggal_mulai'     => $r['tanggal_mulai'],
+        'tanggal_selesai'   => $r['tanggal_selesai'],
+        'startDate'         => $r['tanggal_mulai'],
+        'endDate'           => $r['tanggal_selesai'],
+        'tahun_ajaran'      => $r['tahun_ajaran'],
+        'status'            => pklStatusPenempatan($r['tanggal_mulai'], $r['tanggal_selesai']),
+        'jumlah_jurnal'     => (int)($r['jumlah_jurnal'] ?? 0),
+        'jurnal_terakhir'   => $r['jurnal_terakhir'] ?? null,
+        'milik'             => $ctx !== null && $ctx['guru'] && $r['guru_id'] === $ctx['uid'],
+        'kelas_wali'        => $ctx !== null && pklDalamCakupanWali($ctx, $r['kelas_id'], $r['kelas_nama']),
+        'bisa_ubah'         => $ctx !== null && pklMilikPenempatan($ctx, $r),
+    ];
+}
+
+function pklAmbilPenempatan(mysqli $db, string $id): ?array
+{
+    return pklAmbilSatu($db, PKL_SQL_PENEMPATAN . " WHERE p.id = ?", 's', [$id]);
+}
+
+function pklFotoDecode(?string $json): array
+{
+    $f = json_decode((string)$json, true);
+    return is_array($f) ? array_values(array_filter($f, 'is_string')) : [];
+}
+
+function pklBarisJurnal(array $r, ?array $ctx = null): array
+{
+    $milik = $ctx !== null && $ctx['guru'] && $r['guru_id'] === $ctx['uid'];
+    return [
+        'id'              => $r['id'],
+        'penempatan_id'   => $r['penempatan_id'],
+        'guru_id'         => $r['guru_id'],
+        'guru_nama'       => $r['guru_nama'],
+        'teacherName'     => $r['guru_nama'],
+        'siswa_id'        => $r['siswa_id'],
+        'siswa_nama'      => $r['siswa_nama'] ?? null,
+        'studentName'     => $r['siswa_nama'] ?? null,
+        'kelas_nama'      => $r['kelas_nama'] ?? null,
+        'dudi_nama'       => $r['dudi_nama'] ?? null,
+        'tanggal'         => $r['tanggal'],
+        'date'            => $r['tanggal'],
+        'jam_mulai'       => $r['jam_mulai'],
+        'jam_selesai'     => $r['jam_selesai'],
+        'jenis'           => $r['jenis'],
+        'jenis_label'     => PKL_JENIS[$r['jenis']] ?? $r['jenis'],
