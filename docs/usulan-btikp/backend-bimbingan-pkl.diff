+/**
+ * Penempatan aktif atau akan datang per siswa (yang paling awal).
+ */
+function pklPenempatanBerjalan(mysqli $db): array
+{
+    $hasil = [];
+    $rows = pklAmbilSemua($db,
+        "SELECT p.siswa_id, p.guru_id, p.guru_nama, p.tanggal_mulai, p.tanggal_selesai, d.nama AS dudi_nama
+         FROM pkl_penempatan p LEFT JOIN pkl_dudi d ON d.id = p.dudi_id
+         WHERE p.tanggal_selesai >= ? ORDER BY p.tanggal_mulai", 's', [pklHariIni()]);
+    foreach ($rows as $r) {
+        if (isset($hasil[$r['siswa_id']])) continue;
+        $hasil[$r['siswa_id']] = [
+            'guru_id'         => $r['guru_id'],
+            'guru_nama'       => $r['guru_nama'],
+            'dudi_nama'       => $r['dudi_nama'],
+            'tanggal_mulai'   => $r['tanggal_mulai'],
+            'tanggal_selesai' => $r['tanggal_selesai'],
+        ];
+    }
+    return $hasil;
+}
