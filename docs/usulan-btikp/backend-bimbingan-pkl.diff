+/**
+ * Guru pembimbing tujuan penempatan baru. ADMIN memilih guru_id; GURU selalu dirinya sendiri.
+ */
+function pklGuruTujuan(mysqli $db, array $ctx, string $guruId): array
+{
+    if ($ctx['guru']) {
+        if (!$ctx['pembimbing']) errorResponse(PKL_MSG_SYARAT, 403);
+        return ['uid' => $ctx['uid'], 'nama' => $ctx['nama']];
+    }
+    if (!$ctx['admin']) errorResponse('Kepala Sekolah hanya dapat memantau Bimbingan PKL.', 403);
+    if ($guruId === '') errorResponse('Pilih guru pembimbing');
+    $g = pklAmbilSatu($db, "SELECT uid, displayName, role FROM users WHERE uid = ?", 's', [$guruId]);
+    if (!$g || $g['role'] !== 'GURU') errorResponse('Guru pembimbing tidak ditemukan');
+    if (!pklSyaratPembimbing($db, $g['uid'])) errorResponse($g['displayName'] . ' tidak memiliki penugasan mapel kelas XII, sehingga tidak dapat menjadi pembimbing PKL.');
+    return ['uid' => $g['uid'], 'nama' => $g['displayName']];
+}
+
+/**
+ * POST ?action=pkl_penempatan_simpan
+ *  Buat : {siswa_ids[] | siswa_id, dudi_id, tanggal_mulai, tanggal_selesai, guru_id? (ADMIN)}
+ *  Ubah : {id, dudi_id, tanggal_mulai, tanggal_selesai}
+ */
+function handlePklPenempatanSimpan(mysqli $db): void
+{
+    pklWajibMetode('POST');
+    $ctx = pklKonteks($db);
+    if (!$ctx['admin'] && !$ctx['guru']) errorResponse('Kepala Sekolah hanya dapat memantau Bimbingan PKL.', 403);
+    $body = getRequestBody();
+    $id = trim((string)($body['id'] ?? ''));
+    if ($id === '' && $ctx['guru'] && !$ctx['pembimbing']) errorResponse(PKL_MSG_SYARAT, 403);
+    $mulai = (string)($body['tanggal_mulai'] ?? '');
+    $selesai = (string)($body['tanggal_selesai'] ?? '');
+    pklValidasiRentang($mulai, $selesai);
+    $dudiId = trim((string)($body['dudi_id'] ?? ''));
+    if ($dudiId === '' || !pklAmbilSatu($db, "SELECT id FROM pkl_dudi WHERE id = ?", 's', [$dudiId])) errorResponse('Pilih DU/DI tempat PKL');
+
+    if ($id !== '') {
+        pklPenempatanUbah($db, $ctx, $id, $dudiId, $mulai, $selesai);
+        return;
+    }
+
+    $guru = pklGuruTujuan($db, $ctx, trim((string)($body['guru_id'] ?? '')));
+    $ids = $body['siswa_ids'] ?? (isset($body['siswa_id']) ? [$body['siswa_id']] : []);
+    if (!is_array($ids)) $ids = [];
+    $ids = array_values(array_unique(array_filter(array_map(fn($v) => is_scalar($v) ? trim((string)$v) : '', $ids), fn($v) => $v !== '')));
+    if (!$ids) errorResponse('Pilih minimal satu siswa');
+    if (count($ids) > 60) errorResponse('Maksimal 60 siswa sekali simpan');
+
+    $ph = implode(',', array_fill(0, count($ids), '?'));
+    $siswa = [];
+    foreach (pklAmbilSemua($db, "SELECT id, name, class_id, class_name, status FROM students WHERE id IN ($ph)", str_repeat('s', count($ids)), $ids) as $s) {
+        $siswa[$s['id']] = $s;
+    }
+    $peta = pklPetaKelas($db);
+    [$tahunAjaran] = activeAcademicPeriod($db);
+    $kini = pklSekarang();
+
+    $tersimpan = [];
+    $gagal = [];
+    $adaBentrok = false;
+    foreach ($ids as $sid) {
+        $s = $siswa[$sid] ?? null;
+        $namaSiswa = $s['name'] ?? $sid;
+        if (!$s) { $gagal[] = ['siswa_id' => $sid, 'nama' => $sid, 'alasan' => 'Siswa tidak ditemukan']; continue; }
+        $st = strtoupper(trim((string)$s['status']));
+        if ($st !== '' && $st !== 'AKTIF') { $gagal[] = ['siswa_id' => $sid, 'nama' => $namaSiswa, 'alasan' => 'Siswa tidak berstatus aktif']; continue; }
+        if (!pklKelasXII($peta, $s['class_id'], $s['class_name'])) { $gagal[] = ['siswa_id' => $sid, 'nama' => $namaSiswa, 'alasan' => 'Siswa bukan kelas XII']; continue; }
+
+        pklKunciSiswa($db, $sid);
+        try {
+            $bentrok = pklCekTumpangTindih($db, $sid, $mulai, $selesai);
+            if ($bentrok) {
+                $adaBentrok = true;
+                $gagal[] = ['siswa_id' => $sid, 'nama' => $namaSiswa, 'alasan' => pklPesanBentrok($bentrok)];
+                continue;
+            }
+            $pid = uniqid('pklp_', true);
+            $kelasNama = (string)($s['class_name'] ?: $s['class_id']);
+            $stmt = $db->prepare("INSERT INTO pkl_penempatan (id, siswa_id, siswa_nama, kelas_id, kelas_nama, dudi_id, guru_id, guru_nama,
+                                    tanggal_mulai, tanggal_selesai, tahun_ajaran, dibuat_oleh, dibuat_pada)
+                                  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
+            $stmt->bind_param('sssssssssssss', $pid, $sid, $s['name'], $s['class_id'], $kelasNama, $dudiId, $guru['uid'], $guru['nama'],
+                $mulai, $selesai, $tahunAjaran, $ctx['uid'], $kini);
+            $stmt->execute();
+            $tersimpan[] = pklBarisPenempatan(pklAmbilPenempatan($db, $pid), $ctx);
+        } finally {
+            pklLepasKunciSiswa($db, $sid);
+        }
+    }
+
+    if (!$tersimpan) {
+        jsonResponse(['error' => $gagal[0]['alasan'] ?? 'Tidak ada penempatan yang tersimpan', 'gagal' => $gagal], $adaBentrok ? 409 : 400);
+    }
+    jsonResponse(['success' => true, 'tersimpan' => $tersimpan, 'gagal' => $gagal]);
+}
+
+function pklPenempatanUbah(mysqli $db, array $ctx, string $id, string $dudiId, string $mulai, string $selesai): void
+{
+    $p = pklAmbilPenempatan($db, $id);
+    if (!$p) errorResponse('Penempatan tidak ditemukan', 404);
+    if (!pklMilikPenempatan($ctx, $p)) errorResponse('Anda hanya dapat mengubah penempatan siswa bimbingan Anda sendiri.', 403);
+
+    $rj = pklRentangJurnal($db, $id);
+    if ($rj['n'] > 0) {
+        if ($dudiId !== $p['dudi_id']) errorResponse('Penempatan sudah memiliki jurnal, DU/DI tidak dapat diganti. Tutup penempatan ini lalu buat penempatan baru.');
+        if ($mulai > $rj['awal'] || $selesai < $rj['akhir']) {
+            errorResponse('Periode harus tetap mencakup tanggal jurnal yang sudah ada (' . pklTglPendek($rj['awal']) . ' – ' . pklTglPendek($rj['akhir']) . ')');
+        }
+    }
+
+    pklKunciSiswa($db, $p['siswa_id']);
+    try {
+        $bentrok = pklCekTumpangTindih($db, $p['siswa_id'], $mulai, $selesai, $id);
+        if ($bentrok) errorResponse(pklPesanBentrok($bentrok), 409);
+        $kini = pklSekarang();
+        $stmt = $db->prepare("UPDATE pkl_penempatan SET dudi_id = ?, tanggal_mulai = ?, tanggal_selesai = ?, diubah_oleh = ?, diubah_pada = ? WHERE id = ?");
+        $stmt->bind_param('ssssss', $dudiId, $mulai, $selesai, $ctx['uid'], $kini, $id);
+        $stmt->execute();
+    } finally {
+        pklLepasKunciSiswa($db, $p['siswa_id']);
+    }
+    jsonResponse(['success' => true, 'tersimpan' => [pklBarisPenempatan(pklAmbilPenempatan($db, $id), $ctx)], 'gagal' => []]);
+}
