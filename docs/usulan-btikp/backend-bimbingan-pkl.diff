+    if (!pklTanggalValid($tgl)) errorResponse('Tanggal selesai tidak valid');
+    if ($tgl < $p['tanggal_mulai']) errorResponse('Tanggal selesai tidak boleh sebelum tanggal mulai (' . pklTglPendek($p['tanggal_mulai']) . ')');
+    if ($tgl > $p['tanggal_selesai']) errorResponse('Tanggal tutup tidak boleh melewati tanggal selesai saat ini (' . pklTglPendek($p['tanggal_selesai']) . '). Gunakan Ubah untuk memperpanjang.');
+    $rj = pklRentangJurnal($db, $id);
+    if ($rj['n'] > 0 && $tgl < $rj['akhir']) errorResponse('Tanggal selesai tidak boleh sebelum jurnal terakhir (' . pklTglPendek($rj['akhir']) . ')');
+
+    $kini = pklSekarang();
