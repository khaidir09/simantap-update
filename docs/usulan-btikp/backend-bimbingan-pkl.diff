+/**
+ * GET ?action=pkl_penempatan_list[&guru=&kelas_id=&dudi_id=&status=&siswa=]
+ */
+function handlePklPenempatanList(mysqli $db): void
+{
+    pklWajibMetode('GET');
+    $ctx = pklKonteks($db);
+
+    $types = '';
+    $params = [];
+    $where = [pklKondisiCakupan($ctx, 'p', $types, $params)];
+    foreach (['guru' => 'p.guru_id', 'dudi_id' => 'p.dudi_id', 'siswa' => 'p.siswa_id'] as $q => $kolom) {
+        $v = trim((string)($_GET[$q] ?? ''));
+        if ($v === '') continue;
+        $where[] = "$kolom = ?";
+        $types .= 's';
+        $params[] = $v;
+    }
+    $kelas = trim((string)($_GET['kelas_id'] ?? ''));
+    if ($kelas !== '') $where[] = rekapKeyCondition(['p.kelas_id', 'p.kelas_nama'], [normalizeClassKey($kelas)], $types, $params);
+    $hari = pklHariIni();
+    $status = strtoupper(trim((string)($_GET['status'] ?? '')));
+    if ($status === 'AKTIF') {
+        $where[] = 'p.tanggal_mulai <= ? AND p.tanggal_selesai >= ?';
+        $types .= 'ss';
+        array_push($params, $hari, $hari);
+    } elseif ($status === 'AKAN_DATANG') {
+        $where[] = 'p.tanggal_mulai > ?';
+        $types .= 's';
+        $params[] = $hari;
+    } elseif ($status === 'SELESAI') {
+        $where[] = 'p.tanggal_selesai < ?';
+        $types .= 's';
+        $params[] = $hari;
+    }
+
+    $rows = pklAmbilSemua($db,
+        PKL_SQL_PENEMPATAN . ' WHERE ' . implode(' AND ', $where) . ' ORDER BY p.kelas_nama, p.siswa_nama, p.tanggal_mulai',
+        $types, $params);
+    $hasil = ['items' => array_map(fn($r) => pklBarisPenempatan($r, $ctx), $rows)];
+
+    // Siswa XII aktif tanpa penempatan aktif/akan datang (Pantau & wali kelas)
+    if ($ctx['admin'] || $ctx['kepsek'] || $ctx['wali'] !== null) {
+        $berjalan = pklPenempatanBerjalan($db);
+        [, $siswa] = pklSiswaXII($db);
+        $belum = [];
+        foreach ($siswa as $s) {
+            if (isset($berjalan[$s['id']])) continue;
+            if (!$ctx['admin'] && !$ctx['kepsek'] && !pklDalamCakupanWali($ctx, $s['kelas_id'], $s['kelas_nama'])) continue;
+            $belum[] = $s;
+        }
+        $hasil['belum_ditempatkan'] = $belum;
+    }
+    jsonResponse($hasil);
+}
