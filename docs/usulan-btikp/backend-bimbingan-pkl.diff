+/**
+ * POST ?action=pkl_jurnal_simpan
+ * body {id?, penempatan_id, tanggal, jam_mulai, jam_selesai, jenis, uraian, kondisi_siswa?, permasalahan?, tindak_lanjut?, foto?[]}
+ */
+function handlePklJurnalSimpan(mysqli $db): void
+{
+    pklWajibMetode('POST');
+    $ctx = pklKonteks($db);
+    if (!$ctx['guru']) errorResponse('Jurnal bimbingan hanya ditulis oleh guru pembimbing.', 403);
+    $body = getRequestBody();
+
+    $id = trim((string)($body['id'] ?? ''));
+    $lama = null;
+    if ($id !== '') {
+        $lama = pklAmbilSatu($db, "SELECT * FROM pkl_jurnal WHERE id = ?", 's', [$id]);
+        if (!$lama) errorResponse('Jurnal tidak ditemukan', 404);
+        if ($lama['guru_id'] !== $ctx['uid']) errorResponse('Anda hanya dapat mengubah jurnal Anda sendiri.', 403);
+        $penempatanId = $lama['penempatan_id'];
+    } else {
+        $penempatanId = trim((string)($body['penempatan_id'] ?? ''));
+    }
+
+    $p = pklAmbilPenempatan($db, $penempatanId);
+    if (!$p) errorResponse('Pilih siswa bimbingan', $penempatanId === '' ? 400 : 404);
+    if ($lama === null && $p['guru_id'] !== $ctx['uid']) errorResponse('Anda hanya dapat menulis jurnal untuk siswa bimbingan Anda sendiri.', 403);
+
+    $tanggal = (string)($body['tanggal'] ?? '');
+    if (!pklTanggalValid($tanggal)) errorResponse('Tanggal tidak valid');
+    if ($tanggal > pklHariIni()) errorResponse('Tanggal jurnal tidak boleh di masa depan');
+    if ($tanggal < $p['tanggal_mulai'] || $tanggal > $p['tanggal_selesai']) {
+        errorResponse('Tanggal jurnal harus dalam periode penempatan (' . pklTglPendek($p['tanggal_mulai']) . ' – ' . pklTglPendek($p['tanggal_selesai']) . ')');
+    }
+    $jamMulai = (string)($body['jam_mulai'] ?? '');
+    $jamSelesai = (string)($body['jam_selesai'] ?? '');
+    $polaJam = '/^([01]\d|2[0-3]):[0-5]\d$/';
+    if (!preg_match($polaJam, $jamMulai) || !preg_match($polaJam, $jamSelesai)) errorResponse('Jam mulai dan selesai wajib diisi (format JJ:MM)');
+    if ($jamSelesai <= $jamMulai) errorResponse('Jam selesai harus setelah jam mulai');
+    $jenis = strtoupper(trim((string)($body['jenis'] ?? '')));
+    if (!isset(PKL_JENIS[$jenis])) errorResponse('Jenis kegiatan tidak dikenal');
+    $uraian = pklTeks($body, 'uraian', 5000, 'Uraian kegiatan/materi bimbingan', true);
+    $kondisi = pklTeks($body, 'kondisi_siswa', 2000, 'Kondisi/perkembangan siswa');
+    $masalah = pklTeks($body, 'permasalahan', 2000, 'Permasalahan');
+    $tindak = pklTeks($body, 'tindak_lanjut', 2000, 'Tindak lanjut');
+    $foto = pklValidasiFoto($body['foto'] ?? []);
+    $fotoJson = $foto ? json_encode($foto, JSON_UNESCAPED_SLASHES) : null;
+    $kini = pklSekarang();
+
+    if ($lama === null) {
+        $id = uniqid('pklj_', true);
+        $stmt = $db->prepare("INSERT INTO pkl_jurnal (id, penempatan_id, guru_id, guru_nama, siswa_id, tanggal, jam_mulai, jam_selesai, jenis,
+                                uraian, kondisi_siswa, permasalahan, tindak_lanjut, foto_json, dibuat_pada)
+                              VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
+        $stmt->bind_param('sssssssssssssss', $id, $penempatanId, $ctx['uid'], $ctx['nama'], $p['siswa_id'], $tanggal, $jamMulai, $jamSelesai,
+            $jenis, $uraian, $kondisi, $masalah, $tindak, $fotoJson, $kini);
+    } else {
+        $stmt = $db->prepare("UPDATE pkl_jurnal SET tanggal = ?, jam_mulai = ?, jam_selesai = ?, jenis = ?, uraian = ?, kondisi_siswa = ?,
+                                permasalahan = ?, tindak_lanjut = ?, foto_json = ?, diubah_pada = ? WHERE id = ?");
+        $stmt->bind_param('sssssssssss', $tanggal, $jamMulai, $jamSelesai, $jenis, $uraian, $kondisi, $masalah, $tindak, $fotoJson, $kini, $id);
+    }
+    $stmt->execute();
+    if ($lama !== null) pklHapusFotoYatim($db, array_diff(pklFotoDecode($lama['foto_json']), $foto));
+
+    $row = pklAmbilSatu($db, PKL_SQL_JURNAL . " WHERE j.id = ?", 's', [$id]);
+    jsonResponse(['success' => true, 'item' => pklBarisJurnal($row, $ctx)]);
+}
