+/**
+ * Konteks untuk halaman cetak: galat berupa HTML, bukan JSON.
+ */
+function pklKonteksCetak(mysqli $db): array
+{
+    if (($_SERVER['REQUEST_METHOD'] ?? 'GET') !== 'GET') {
+        header('Allow: GET');
+        pklHtmlError(405, 'Metode tidak diizinkan.');
+    }
+    $sesi = getCurrentUser();
+    if (!$sesi || empty($sesi['uid'])) pklHtmlError(401, 'Sesi Anda telah berakhir. Silakan login ulang.');
+    $fresh = pklAmbilSatu($db, "SELECT uid, displayName, role, class_homeroom, is_bk FROM users WHERE uid = ? LIMIT 1", 's', [$sesi['uid']]);
+    if (!$fresh) pklHtmlError(401, 'Sesi Anda telah berakhir. Silakan login ulang.');
+    $ctx = pklKonteksDari($db, $fresh);
+    if ($ctx === null) pklHtmlError(403, PKL_MSG_DENY);
+    pklPastikanTabel($db);
+    return $ctx;
+}
