+/**
+ * Hapus file foto yang tidak lagi dipakai jurnal mana pun.
+ */
+function pklHapusFotoYatim(mysqli $db, array $paths): void
+{
+    foreach ($paths as $f) {
+        if (!is_string($f) || !preg_match(PKL_POLA_FOTO, $f)) continue;
+        $pakai = pklAmbilSatu($db, "SELECT COUNT(*) AS n FROM pkl_jurnal WHERE foto_json LIKE ?", 's', ['%' . $f . '%']);
+        $berkas = dirname(__DIR__) . '/' . $f;
+        if ((int)$pakai['n'] === 0 && is_file($berkas)) @unlink($berkas);
+    }
+}
