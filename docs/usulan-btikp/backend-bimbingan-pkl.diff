+/**
+ * Siswa aktif kelas XII (opsional satu kelas). Hasil: [kelas[], siswa[]].
+ */
+function pklSiswaXII(mysqli $db, string $kelasFilter = ''): array
+{
+    $peta = pklPetaKelas($db);
+    $rows = pklAmbilSemua($db,
+        "SELECT s.id, s.name, s.nisn, s.class_id, s.class_name FROM students s WHERE " . PKL_SISWA_AKTIF . " ORDER BY s.class_name, s.name",
+        '', []);
+    $kelas = [];
+    $siswa = [];
+    $filterKey = normalizeClassKey($kelasFilter);
+    foreach ($rows as $s) {
+        if (!pklKelasXII($peta, $s['class_id'], $s['class_name'])) continue;
+        $k = normalizeClassKey($s['class_id']);
+        $info = $peta[$k] ?? ($peta[normalizeClassKey($s['class_name'])] ?? null);
+        $kid = $info['id'] ?? (string)$s['class_id'];
+        $knama = $info['name'] ?? (string)($s['class_name'] ?: $s['class_id']);
+        $kelas[$kid] = ['id' => $kid, 'nama' => $knama];
+        if ($filterKey !== '' && !in_array($filterKey, [normalizeClassKey($s['class_id']), normalizeClassKey($s['class_name']), normalizeClassKey($kid)], true)) continue;
+        $siswa[] = [
+            'id'         => $s['id'],
+            'nama'       => $s['name'],
+            'nisn'       => $s['nisn'],
+            'kelas_id'   => (string)$s['class_id'],
+            'kelas_nama' => (string)($s['class_name'] ?: $s['class_id']),
+        ];
+    }
+    $kelas = array_values($kelas);
+    usort($kelas, fn($a, $b) => strnatcasecmp($a['nama'], $b['nama']));
+    return [$kelas, $siswa];
+}
