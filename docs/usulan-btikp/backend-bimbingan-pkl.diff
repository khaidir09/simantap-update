+
+function pklNamaGuru(mysqli $db, string $uid, string $cadangan): array
+{
+    $u = pklAmbilSatu($db, "SELECT displayName, nip FROM users WHERE uid = ?", 's', [$uid]);
+    return ['nama' => $u['displayName'] ?? $cadangan, 'nip' => trim((string)($u['nip'] ?? ''))];
+}
+
+function pklMenit(string $mulai, string $selesai): int
+{
+    [$h1, $m1] = array_map('intval', explode(':', $mulai));
+    [$h2, $m2] = array_map('intval', explode(':', $selesai));
+    return max(0, ($h2 * 60 + $m2) - ($h1 * 60 + $m1));
+}
+
+function pklLabelDurasi(int $menit): string
+{
+    $j = intdiv($menit, 60);
+    $m = $menit % 60;
+    return trim(($j ? "$j jam " : '') . ($m ? "$m menit" : '')) ?: '0 menit';
+}
+
+function pklNamaHari(string $ymd): string
+{
+    $hari = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
+    return $hari[(int)(new DateTimeImmutable($ymd))->format('w')];
+}
