+function pklTtdKotaTanggal(array $kop, string $tanggalDefault): array
+{
+    $kotaRaw = $_GET['kota'] ?? null;
+    $kota = $kotaRaw === null ? ($kop['kop_kota'] ?? '') : trim((string)$kotaRaw);
+    $kota = mb_substr($kota, 0, 50, 'UTF-8');
+    $tglRaw = trim((string)($_GET['tgl_ttd'] ?? ''));
+    $tgl = $tanggalDefault;
+    if ($tglRaw !== '') {
+        if (!pklTanggalValid($tglRaw)) pklHtmlError(400, 'Tanggal tanda tangan tidak valid (gunakan YYYY-MM-DD).');
+        $tgl = $tglRaw;
+    }
