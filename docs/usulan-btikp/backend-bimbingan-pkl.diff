+/**
+ * POST ?action=pkl_dudi_simpan — body {id?, nama, bidang_usaha?, alamat?, pembimbing_nama?, pembimbing_telp?, catatan?}
+ */
+function handlePklDudiSimpan(mysqli $db): void
+{
+    pklWajibMetode('POST');
+    $ctx = pklKonteks($db);
+    if (!$ctx['admin'] && !$ctx['pembimbing']) {
+        errorResponse($ctx['guru'] ? PKL_MSG_SYARAT : PKL_MSG_DENY, 403);
+    }
+    $body = getRequestBody();
+    $id = trim((string)($body['id'] ?? ''));
+    $nama = pklTeks($body, 'nama', 255, 'Nama DU/DI', true);
+    $norm = pklNormNama($nama);
+    if ($norm === '') errorResponse('Nama DU/DI tidak valid');
+    $bidang = pklTeks($body, 'bidang_usaha', 150, 'Bidang usaha');
+    $alamat = pklTeks($body, 'alamat', 1000, 'Alamat');
+    $pNama  = pklTeks($body, 'pembimbing_nama', 150, 'Nama pembimbing industri');
+    $pTelp  = pklTeks($body, 'pembimbing_telp', 30, 'Telepon pembimbing industri');
+    if ($pTelp !== null && !preg_match('/^[0-9+()\-\s.]{5,30}$/', $pTelp)) errorResponse('Telepon pembimbing industri tidak valid');
+    $catatan = pklTeks($body, 'catatan', 2000, 'Catatan');
+
+    if ($id !== '') {
+        $lama = pklAmbilSatu($db, "SELECT * FROM pkl_dudi WHERE id = ?", 's', [$id]);
+        if (!$lama) errorResponse('DU/DI tidak ditemukan', 404);
+        if (!$ctx['admin']) {
+            if ($lama['dibuat_oleh'] !== $ctx['uid']) errorResponse('Hanya Admin yang dapat mengubah DU/DI yang ditambahkan guru lain.', 403);
+            $lain = pklAmbilSatu($db, "SELECT COUNT(*) AS n FROM pkl_penempatan WHERE dudi_id = ? AND guru_id <> ?", 'ss', [$id, $ctx['uid']]);
+            if ((int)$lain['n'] > 0) errorResponse('DU/DI ini sudah dipakai guru lain. Minta Admin untuk mengubahnya.', 403);
+        }
+    }
+
+    $sama = pklAmbilSatu($db, "SELECT id, nama FROM pkl_dudi WHERE nama_norm = ? AND id <> ?", 'ss', [$norm, $id]);
+    if ($sama) jsonResponse(['error' => 'DU/DI sudah ada: ' . $sama['nama'], 'existing' => $sama], 409);
+
+    $kini = pklSekarang();
+    try {
+        if ($id === '') {
+            $id = uniqid('dudi_', true);
+            $stmt = $db->prepare("INSERT INTO pkl_dudi (id, nama, nama_norm, bidang_usaha, alamat, pembimbing_nama, pembimbing_telp, catatan, dibuat_oleh, dibuat_pada)
+                                  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
+            $stmt->bind_param('ssssssssss', $id, $nama, $norm, $bidang, $alamat, $pNama, $pTelp, $catatan, $ctx['uid'], $kini);
+        } else {
+            $stmt = $db->prepare("UPDATE pkl_dudi SET nama = ?, nama_norm = ?, bidang_usaha = ?, alamat = ?, pembimbing_nama = ?, pembimbing_telp = ?, catatan = ?, diubah_pada = ?
+                                  WHERE id = ?");
+            $stmt->bind_param('sssssssss', $nama, $norm, $bidang, $alamat, $pNama, $pTelp, $catatan, $kini, $id);
+        }
+        $stmt->execute();
+    } catch (mysqli_sql_exception $e) {
+        // Balapan dua guru menambah nama yang sama: kunci unik nama_norm
+        if ($e->getCode() === 1062) {
+            $sama = pklAmbilSatu($db, "SELECT id, nama FROM pkl_dudi WHERE nama_norm = ?", 's', [$norm]);
+            jsonResponse(['error' => 'DU/DI sudah ada: ' . ($sama['nama'] ?? $nama), 'existing' => $sama], 409);
+        }
+        throw $e;
+    }
+    $row = pklAmbilSatu($db, "SELECT * FROM pkl_dudi WHERE id = ?", 's', [$id]);
+    jsonResponse(['success' => true, 'item' => pklBarisDudi($row)]);
+}
