+/**
+ * Validasi foto: array path hasil pkl_unggah_foto, maks 3, file harus ada.
+ */
+function pklValidasiFoto($foto): array
+{
+    if ($foto === null || $foto === '') return [];
+    if (!is_array($foto)) errorResponse('Data foto tidak valid');
+    $hasil = [];
+    foreach ($foto as $f) {
+        if (!is_string($f) || !preg_match(PKL_POLA_FOTO, $f)) errorResponse('Foto tidak valid, unggah ulang');
+        if (!is_file(dirname(__DIR__) . '/' . $f)) errorResponse('Foto tidak ditemukan, unggah ulang');
+        $hasil[] = $f;
+    }
+    $hasil = array_values(array_unique($hasil));
+    if (count($hasil) > PKL_MAKS_FOTO) errorResponse('Maksimal ' . PKL_MAKS_FOTO . ' foto');
+    return $hasil;
+}
