+    $ctx = pklKonteks($db);
+    if (!pklBolehBaca($ctx)) errorResponse(PKL_MSG_DENY, 403);
+
+    $q = trim((string)($_GET['q'] ?? ''));
+    $hari = pklHariIni();
+    $sql = "SELECT d.*,
+                (SELECT COUNT(*) FROM pkl_penempatan p WHERE p.dudi_id = d.id) AS jumlah_penempatan,
+                (SELECT COUNT(*) FROM pkl_penempatan p WHERE p.dudi_id = d.id AND p.tanggal_mulai <= ? AND p.tanggal_selesai >= ?) AS jumlah_penempatan_aktif
+            FROM pkl_dudi d";
+    $types = 'ss';
+    $params = [$hari, $hari];
+    if ($q !== '') {
+        $sql .= " WHERE d.nama LIKE ? OR d.alamat LIKE ? OR d.bidang_usaha LIKE ?";
+        $like = '%' . $q . '%';
+        $types .= 'sss';
+        array_push($params, $like, $like, $like);
+    }
+    $sql .= " ORDER BY d.nama";
+    $items = array_map('pklBarisDudi', pklAmbilSemua($db, $sql, $types, $params));
+    foreach ($items as &$it) {
+        $it['bisa_ubah'] = $ctx['admin'] || ($ctx['pembimbing'] && $it['dibuat_oleh'] === $ctx['uid']);
+        $it['bisa_hapus'] = $ctx['admin'] && $it['jumlah_penempatan'] === 0;
+    }
+    unset($it);
+    jsonResponse(['items' => $items]);
+}
