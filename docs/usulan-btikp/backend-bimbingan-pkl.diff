+/**
+ * GET ?action=pkl_jurnal_list[&bulan=YYYY-MM&penempatan_id=&siswa=&guru=]
+ * Tanpa filter apa pun: bulan berjalan.
+ */
+function handlePklJurnalList(mysqli $db): void
+{
+    pklWajibMetode('GET');
+    $ctx = pklKonteks($db);
+
+    $types = '';
+    $params = [];
+    $cakupan = pklKondisiCakupan($ctx, 'p', $types, $params);
+    // GURU juga melihat jurnal yang ia tulis di penempatan yang sudah dialihkan
+    if (!$ctx['admin'] && !$ctx['kepsek']) {
+        $cakupan = "($cakupan OR j.guru_id = ?)";
+        $types .= 's';
+        $params[] = $ctx['uid'];
+    }
+    $where = [$cakupan];
+
+    $adaFilter = false;
+    foreach (['penempatan_id' => 'j.penempatan_id', 'siswa' => 'j.siswa_id', 'guru' => 'j.guru_id'] as $q => $kolom) {
+        $v = trim((string)($_GET[$q] ?? ''));
+        if ($v === '') continue;
+        $where[] = "$kolom = ?";
+        $types .= 's';
+        $params[] = $v;
+        if ($q !== 'guru') $adaFilter = true;
+    }
+    $bulan = trim((string)($_GET['bulan'] ?? ''));
+    if ($bulan === '' && !$adaFilter) $bulan = date('Y-m');
+    if ($bulan !== '') {
+        if (!preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $bulan)) errorResponse('Format bulan tidak valid (YYYY-MM)');
+        $awal = $bulan . '-01';
+        $akhir = (new DateTimeImmutable($awal))->format('Y-m-t');
+        $where[] = 'j.tanggal BETWEEN ? AND ?';
+        $types .= 'ss';
+        array_push($params, $awal, $akhir);
+    }
+    $rows = pklAmbilSemua($db,
+        PKL_SQL_JURNAL . ' WHERE ' . implode(' AND ', $where) . ' ORDER BY j.tanggal DESC, j.jam_mulai DESC',
+        $types, $params);
+    jsonResponse(['bulan' => $bulan ?: null, 'items' => array_map(fn($r) => pklBarisJurnal($r, $ctx), $rows)]);
+}
