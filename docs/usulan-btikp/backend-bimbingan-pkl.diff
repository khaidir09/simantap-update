+/**
+ * POST multipart ?action=pkl_unggah_foto — field "file" (JPG/PNG/WEBP, maks 2 MB).
+ * Pembimbing yang memenuhi syarat, atau guru yang masih punya penempatan (melanjutkan jurnal).
+ */
+function handlePklUnggahFoto(mysqli $db): void
+{
+    pklWajibMetode('POST');
+    $ctx = pklKonteks($db);
+    if (!$ctx['guru']) errorResponse('Foto bimbingan hanya diunggah oleh guru pembimbing.', 403);
+    if (!$ctx['pembimbing']) {
+        $punya = pklAmbilSatu($db, "SELECT COUNT(*) AS n FROM pkl_penempatan WHERE guru_id = ?", 's', [$ctx['uid']]);
+        if ((int)$punya['n'] === 0) errorResponse(PKL_MSG_SYARAT, 403);
+    }
+
+    $f = $_FILES['file'] ?? null;
+    if (!$f || !is_array($f) || ($f['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK || !is_uploaded_file($f['tmp_name'])) {
+        $kode = is_array($f) ? ($f['error'] ?? null) : null;
+        errorResponse(in_array($kode, [UPLOAD_ERR_INI_SIZE, UPLOAD_ERR_FORM_SIZE], true) ? 'Ukuran foto maksimal 2 MB' : 'Foto gagal diunggah');
+    }
+    if ((int)$f['size'] > PKL_MAKS_UNGGAH) errorResponse('Ukuran foto maksimal 2 MB');
+    $mime = (new finfo(FILEINFO_MIME_TYPE))->file($f['tmp_name']);
+    $ext = PKL_MIME_FOTO[$mime] ?? null;
+    if ($ext === null) errorResponse('Foto harus berupa JPG, PNG, atau WEBP');
+
+    $sub = 'uploads/journals/pkl/' . date('Ym');
+    $dir = dirname(__DIR__) . '/' . $sub;
+    if (!is_dir($dir) && !mkdir($dir, 0755, true)) errorResponse('Folder unggahan tidak dapat dibuat', 500);
+    foreach ([dirname($dir, 2), dirname($dir), $dir] as $d) {
+        if (!is_file("$d/index.html")) @file_put_contents("$d/index.html", '');
+    }
+    $nama = bin2hex(random_bytes(16)) . '.' . $ext;
+    if (!move_uploaded_file($f['tmp_name'], "$dir/$nama")) errorResponse('Foto gagal disimpan', 500);
+    jsonResponse(['success' => true, 'path' => "$sub/$nama"]);
+}
