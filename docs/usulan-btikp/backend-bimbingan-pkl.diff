+    }
+
+    $baruId = uniqid('pklp_', true);
+    $mulaiBaru = pklTambahHari($tgl, 1);
+    $kini = pklSekarang();
+    pklKunciSiswa($db, $p['siswa_id']);
+    $db->begin_transaction();
+    try {
+        $stmt = $db->prepare("UPDATE pkl_penempatan SET tanggal_selesai = ?, diubah_oleh = ?, diubah_pada = ? WHERE id = ?");
+        $stmt->bind_param('ssss', $tgl, $ctx['uid'], $kini, $id);
+        $stmt->execute();
+        $stmt = $db->prepare("INSERT INTO pkl_penempatan (id, siswa_id, siswa_nama, kelas_id, kelas_nama, dudi_id, guru_id, guru_nama,
+                                tanggal_mulai, tanggal_selesai, tahun_ajaran, dibuat_oleh, dibuat_pada)
+                              VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
+        $stmt->bind_param('sssssssssssss', $baruId, $p['siswa_id'], $p['siswa_nama'], $p['kelas_id'], $p['kelas_nama'], $p['dudi_id'],
+            $guru['uid'], $guru['nama'], $mulaiBaru, $p['tanggal_selesai'], $p['tahun_ajaran'], $ctx['uid'], $kini);
+        $stmt->execute();
+        $db->commit();
+    } catch (Throwable $e) {
+        $db->rollback();
+        error_log('[SIMANTAP] pkl_penempatan_alih: ' . $e->getMessage() . ' @ ' . $e->getFile() . ':' . $e->getLine());
+        errorResponse('Gagal mengalihkan pembimbing', 500);
+    } finally {
+        pklLepasKunciSiswa($db, $p['siswa_id']);
